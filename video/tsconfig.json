{
  "compilerOptions": {
    "target": "ES2018",
    "module": "Preserve",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "lib": [
      "dom",
      "dom.iterable",
      "es2022"
    ],
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noUnusedLocals": true,
    "paths": {
      "@/*": [
        "../src/*"
      ],
      "react": [
        "../node_modules/@types/react"
      ],
      "react/*": [
        "../node_modules/@types/react/*"
      ],
      "react-dom": [
        "../node_modules/@types/react-dom"
      ],
      "react-dom/*": [
        "../node_modules/@types/react-dom/*"
      ]
    }
  },
  "include": [
    "src"
  ],
  "exclude": [
    "remotion.config.ts"
  ]
}
